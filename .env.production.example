# ─────────────────────────────────────────────────────────────
# Scheme Saathi — PRODUCTION settings
# Copy to .env on the server:   cp .env.production.example .env
#
# In production the server REFUSES TO START if a REQUIRED value is missing,
# and every webhook, cron and admin request must be authenticated.
# Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

# development | production
APP_ENV=production

# Public https URL, no trailing slash. On Vercel it defaults to the production domain.
APP_BASE_URL=https://saathi.example.in

# REQUIRED on Vercel: Supabase Postgres connection string. Use the TRANSACTION POOLER
# (Supabase → Connect → Transaction pooler, port 6543). When set, Postgres is used.
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Connections per instance (default 1 on Vercel, 5 elsewhere).
DATABASE_POOL_MAX=5
# Only for Docker / a VM without DATABASE_URL: SQLite file on a persistent volume.
DATABASE_PATH=/app/data/scheme-saathi.db

# Homepage deep links (baked in at build time; rebuild after changing)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_TELEGRAM_BOT=Scheme_GovBot

# --- Groq (recommended) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Telegram ---
# Set the token to enable Telegram; the secret is then REQUIRED (16+ chars, letters/digits/_/-).
TELEGRAM_BOT_TOKEN=9171066780:AAFRFlw9FVS6EDYFQs4QKkFOWIUA0cJuRhA
TELEGRAM_WEBHOOK_SECRET=fd110da1c3fc1d0ba3e8091bd61ae947610f433250ebf98ebd8ff18d332f6009

# --- WhatsApp Cloud API ---
# Set token + phone number id to enable WhatsApp; verify token and app secret are then REQUIRED.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Approved utility template with 2 body variables, for alerts after 24h of inactivity.
WHATSAPP_NOTIFY_TEMPLATE=
WHATSAPP_TEMPLATE_LANG_EN=en
WHATSAPP_TEMPLATE_LANG_HI=hi
WHATSAPP_TEMPLATE_LANG_ML=ml

# --- Pipeline / admin --- REQUIRED, 16+ characters each
CRON_SECRET=
ADMIN_TOKEN=
# Optional: Telegram chat id that receives pipeline reports (items to review,
# failed sources). Message your bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
ADMIN_TELEGRAM_CHAT_ID=1203594213

# --- Runtime ---
# The /try browser demo uses the real agent (and Groq). Set false to switch it off.
ENABLE_WEB_DEMO=true
# Messages per minute per IP for the web demo.
CHAT_RATE_LIMIT_PER_MIN=20
LOG_LEVEL=info

# --- Monitoring ---
# Sentry (or GlitchTip / any Sentry-compatible) DSN for server error tracking.
SENTRY_DSN=
# Telegram alerts to ADMIN_TELEGRAM_CHAT_ID on errors, at most once per N minutes.
ERROR_ALERTS=true
ERROR_ALERT_MINUTES=10

# --- Serverless (Vercel) ---
# Stop starting new pipeline sources after this many seconds (default 200 on Vercel).
PIPELINE_TIME_BUDGET_SECONDS=
# Optional JSON list of pipeline sources, instead of data/sources.json.
PIPELINE_SOURCES=
