# ─────────────────────────────────────────────────────────────
# Scheme Saathi — DEVELOPMENT settings
# Copy to .env:   cp .env.development.example .env
#
# In development, anything left empty is tolerated: /admin and the pipeline
# endpoint are open, webhook secrets are optional, and missing settings only
# print warnings at startup.
# ─────────────────────────────────────────────────────────────

# development | production
APP_ENV=development

# Public URL. Use your ngrok address when testing webhooks from a phone.
APP_BASE_URL=http://localhost:3000

# Local SQLite database file (created automatically)
DATABASE_PATH=./data/scheme-saathi.db
# Set to a Postgres / Supabase URL to develop against Postgres instead
DATABASE_URL=

# Homepage call-to-action deep links (until set, CTAs open the in-browser demo)
# Digits with country code, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Bot username without @, e.g. SchemeSaathiBot
NEXT_PUBLIC_TELEGRAM_BOT=

# --- Groq (optional) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Telegram (optional in development) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp Cloud API (optional in development) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_NOTIFY_TEMPLATE=
WHATSAPP_TEMPLATE_LANG_EN=en
WHATSAPP_TEMPLATE_LANG_HI=hi
WHATSAPP_TEMPLATE_LANG_ML=ml

# --- Pipeline / admin (open when empty in development) ---
CRON_SECRET=
ADMIN_TOKEN=
# Optional: Telegram chat id that receives pipeline reports (items to review,
# failed sources). Message your bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
ADMIN_TELEGRAM_CHAT_ID=

# --- Runtime ---
ENABLE_WEB_DEMO=true
CHAT_RATE_LIMIT_PER_MIN=60
# debug | info | warn | error
LOG_LEVEL=debug

# --- Monitoring ---
# Sentry (or GlitchTip / any Sentry-compatible) DSN for server error tracking.
SENTRY_DSN=
# Telegram alerts to ADMIN_TELEGRAM_CHAT_ID on errors, at most once per N minutes.
ERROR_ALERTS=true
ERROR_ALERT_MINUTES=10
