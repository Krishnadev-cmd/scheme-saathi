{
  "name": "scheme-saathi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram + WhatsApp agent that matches citizens to Indian government schemes (English, Hindi, Malayalam) and alerts them when application windows open.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "vercel-build": "node --import tsx scripts/vercel-build.ts && next build",
    "start": "node --env-file-if-exists=.env .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check:env": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/check-env.ts",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/db-migrate.ts",
    "seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "pipeline": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/pipeline.ts",
    "telegram:set-webhook": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/set-telegram-webhook.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^11.10.0",
    "next": "^16.4.3",
    "openai": "^6.49.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
